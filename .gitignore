/storage/*.key
/storage/pail

# Tenant-specific storage
!/storage/tenantfoo/
/storage/tenantfoo/app/public/images/*
/storage/tenantfoo/app/public/files/*
!/storage/tenantfoo/app/public/images/product-variant

